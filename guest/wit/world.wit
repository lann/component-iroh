package lann:iroh-spike@0.0.1;

/// The spike's demo surface: one happy-path QUIC-over-data-channel run.
///
/// This is not the designed endpoint surface (that design is tracked
/// upstream); it exists to drive one end-to-end connection and report what
/// happened.
interface demo {
    /// Which side of the connection this process drives. The client is the
    /// WebRTC offerer (it creates the data channel) and the QUIC client;
    /// the server is the answerer and accepts the QUIC connection.
    enum role { client, server }

    /// The wire QUIC runs over. QUIC is end-to-end on either wire: the
    /// relay never holds connection keys.
    enum transport {
        /// A WebRTC data channel between the peers (unreliable and
        /// unordered); the relay carries only signaling.
        webrtc,
        /// The relay connection itself: QUIC datagrams travel as binary
        /// frames forwarded by the relay. No WebRTC involved.
        relay,
    }

    /// One run's inputs.
    record run-config {
        /// The iroh relay server's base URL, e.g. `http://127.0.0.1:3340`
        /// (an `iroh-relay` dev-mode server). Both processes must name the
        /// same relay. `http(s)` schemes are mapped onto `ws(s)`.
        server: string,
        /// This process's role.
        role: role,
        /// The wire QUIC runs over.
        transport: transport,
        /// The server peer's endpoint ID (its Ed25519 public key,
        /// hex-encoded). Required on the client — it addresses relayed
        /// frames and pins the TLS connection. A server needs none: it
        /// learns the client's ID from the relay-authenticated source of
        /// the first inbound frame and cross-checks it against the
        /// handshake.
        peer: option<string>,
        /// The application message the client sends (the server echoes it).
        message: string,
    }

    /// One run's outcome.
    record run-report {
        /// This endpoint's identity: the Ed25519 public key, hex-encoded.
        endpoint-id: string,
        /// The authenticated peer's identity, hex-encoded.
        peer-id: string,
        /// Milliseconds from starting the QUIC handshake to its
        /// completion (crypto through the WIT boundary included).
        handshake-ms: u64,
        /// Milliseconds from sending the application message to receiving
        /// the echo. Zero on the server, which answers rather than sends.
        roundtrip-ms: u64,
        /// The application payload this side received.
        received: string,
    }

    /// Drive one full run: connect to the relay, connect to the peer,
    /// exchange one message each way, and report. The process's own
    /// endpoint ID is written to stdout as `endpoint-id <hex>` before any
    /// connection is attempted, so a driver can hand it to the peer.
    /// Fails with a human-readable reason.
    run: async func(config: run-config) -> result<run-report, string>;
}

/// One demo peer: WebRTC transport and relay connectivity in, the demo run
/// out. Signaling rides a `lann:websocket` connection to the relay server,
/// the leg both sides of the designed endpoint hold anyway.
world iroh-spike {
    import lann:webrtc-datachannels/connections@0.1.0;
    import lann:websocket/connections@0.1.0;
    import wasi:clocks/monotonic-clock@0.3.0;
    export demo;
}
