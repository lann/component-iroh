{
  "name": "iroh-spike-host-jco",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Spike Node host: transpiles the iroh-spike guest with jco and runs it on Node 24+ (JSPI), with webrtc/webcrypto/websocket served by the sibling host modules.",
  "scripts": {
    "transpile": "node ../scripts/jco-transpile.mjs transpile ../target/wasm32-wasip2/release/iroh_spike_guest.wasm --name iroh-spike --async-mode jspi --map 'lann:webcrypto/*@0.1.0=../../.deps/webcrypto/js/jco/webcrypto.js#*' --map 'lann:webrtc-datachannels/connections@0.1.0=../../.deps/webrtc/jco-impl/webrtc.js' --map 'lann:websocket/connections@0.1.0=../../.deps/websocket/js/jco/websocket.js' --map 'wasi:clocks/monotonic-clock@0.3.0=@bytecodealliance/preview3-shim/clocks#monotonicClock' -o generated",
    "start": "node --experimental-wasm-jspi src/run.mjs",
    "transpile-endpoint": "node ../scripts/jco-transpile.mjs transpile ../target/wasm32-wasip2/release/iroh_endpoint.wasm --name iroh-endpoint --async-mode jspi --map 'lann:webcrypto/*@0.1.0=../../.deps/webcrypto/js/jco/webcrypto.js#*' --map 'lann:webrtc-datachannels/connections@0.1.0=../../.deps/webrtc/jco-impl/webrtc.js' --map 'lann:websocket/connections@0.1.0=../../.deps/websocket/js/jco/websocket.js' --map 'wasi:clocks/monotonic-clock@0.3.0=@bytecodealliance/preview3-shim/clocks#monotonicClock' --map 'wasi:sockets/*@0.3.0=@bytecodealliance/preview3-shim/sockets#*' -o generated-endpoint",
    "transpile-exec": "node ../scripts/jco-transpile.mjs transpile ../target/wasm32-wasip2/release/iroh_exec_model_guest.wasm --name exec-model --async-mode jspi --map 'lann:webcrypto/*@0.1.0=../../.deps/webcrypto/js/jco/webcrypto.js#*' --map 'wasi:clocks/monotonic-clock@0.3.0=@bytecodealliance/preview3-shim/clocks#monotonicClock' -o generated-exec",
    "start-endpoint": "node --experimental-wasm-jspi src/run-endpoint.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco-transpile": "file:../.deps/jco/packages/jco-transpile"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.19.0",
    "@bytecodealliance/preview3-shim": "^0.2.2",
    "node-datachannel": "^0.32.3"
  }
}
