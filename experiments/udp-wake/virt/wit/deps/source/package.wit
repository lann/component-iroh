package probe:source@0.0.1;

// The generic host-side event source the virtualization layer feeds on:
// a nonblocking drain + a host pollable for readiness + a sink for
// guest-originated payloads. This is the minimal per-host surface — in a
// real deployment the polymorph host modules play this role.
interface events {
  use wasi:io/poll@0.2.9.{pollable};

  record incoming {
    payload: list<u8>,
    port: u16,
  }

  // A host pollable that is ready while the source queue is non-empty.
  subscribe: func() -> pollable;

  // Nonblocking: everything queued since the last drain.
  drain: func() -> list<incoming>;

  // Deliver a guest payload to the host (the echo path).
  send: func(payload: list<u8>, port: u16);
}
