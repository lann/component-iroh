package probe:virt@0.0.1;

// The portable virtualization layer from issue #14 / PR #18: exports the
// wasi 0.2 surface a tokio guest parks on (io, clocks, stdio, sockets),
// implemented over the *host's* wasi:io + a generic event source. Every
// guest-side pollable maps onto a host pollable, and the exported `poll`
// multiplexes down to a single host `wasi:io/poll#poll` call — the one
// import where JSPI suspension happens. Socket semantics (queues,
// addressing, datagram bridging) live here, in guest code, portably.
world virt {
  // Host-facing: the real implementations this layer wraps.
  import wasi:io/error@0.2.9;
  import wasi:io/poll@0.2.9;
  import wasi:io/streams@0.2.9;
  import wasi:clocks/monotonic-clock@0.2.9;
  import wasi:cli/stdin@0.2.9;
  import wasi:cli/stdout@0.2.9;
  import wasi:cli/stderr@0.2.9;
  import probe:source/events@0.0.1;

  // Guest-facing: the virtualized wasi 0.2 surface.
  export wasi:io/error@0.2.9;
  export wasi:io/poll@0.2.9;
  export wasi:io/streams@0.2.9;
  export wasi:clocks/monotonic-clock@0.2.9;
  export wasi:cli/stdin@0.2.9;
  export wasi:cli/stdout@0.2.9;
  export wasi:cli/stderr@0.2.9;
  export wasi:sockets/network@0.2.9;
  export wasi:sockets/instance-network@0.2.9;
  export wasi:sockets/udp@0.2.9;
  export wasi:sockets/udp-create-socket@0.2.9;
  export wasi:sockets/tcp@0.2.9;
  export wasi:sockets/tcp-create-socket@0.2.9;
}
